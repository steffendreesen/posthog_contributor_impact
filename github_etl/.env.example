# Copy to .env (never commit .env).
# Preferred: paste a GitHub token. Classic PAT needs public_repo (or no extra
# scopes if gh created it). Fine-grained: Contents, Issues, Pull requests, Metadata read.
#
#   cp .env.example .env
#   printf 'GITHUB_TOKEN=%s\n' "$(gh auth token)" > .env
#
GITHUB_TOKEN=
